generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationMode {
  TRAVEL
  TRANSLATION
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageContentType {
  TEXT
}

enum JobStatus {
  ACCEPTED
  COMPLETED
  FAILED
}

model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  mode      ConversationMode
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  Message[]
  jobs      Job[]
  translations Translation[]
  trip         Trip?
}

model Message {
  id             String             @id @default(uuid()) @db.Uuid
  conversationId String             @db.Uuid
  role           MessageRole
  contentType    MessageContentType
  content        Json
  idempotencyKey String?
  createdAt      DateTime           @default(now())
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  job            Job?
  translation    Translation?

  @@unique([conversationId, idempotencyKey])
  @@index([conversationId, createdAt])
}

model Translation {
  id                String   @id @default(uuid()) @db.Uuid
  conversationId    String   @db.Uuid
  sourceMessageId   String   @unique @db.Uuid
  sourceLanguage    String
  targetLanguage    String
  sourceText        String
  translatedText    String
  naturalExpression String
  pronunciation     String?
  politeness        String
  provider           String
  createdAt          DateTime @default(now())
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessage      Message @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Job {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  messageId      String       @unique @db.Uuid
  status         JobStatus    @default(ACCEPTED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  events         JobEvent[]
}

model JobEvent {
  id         String   @id @default(uuid()) @db.Uuid
  jobId      String   @db.Uuid
  sequence   Int
  type       String
  data       Json
  occurredAt DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sequence])
  @@index([jobId, occurredAt])
}

model Trip {
  id             String          @id @default(uuid()) @db.Uuid
  conversationId String          @unique @db.Uuid
  title          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requirement    TripRequirement?
  versions       TripVersion[]
}

model TripRequirement {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @unique @db.Uuid
  data      Json
  pendingField String?
  updatedAt DateTime @updatedAt
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripVersion {
  id            String         @id @default(uuid()) @db.Uuid
  tripId        String         @db.Uuid
  versionNumber Int
  title         String
  summary       String
  currency      String         @db.VarChar(3)
  totalCost     Decimal        @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())
  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  days          ItineraryDay[]

  @@unique([tripId, versionNumber])
}

model ItineraryDay {
  id            String          @id @default(uuid()) @db.Uuid
  tripVersionId String          @db.Uuid
  dayNumber     Int
  date          DateTime?       @db.Date
  title         String
  estimatedCost Decimal         @db.Decimal(12, 2)
  tripVersion   TripVersion     @relation(fields: [tripVersionId], references: [id], onDelete: Cascade)
  items         ItineraryItem[]

  @@unique([tripVersionId, dayNumber])
}

model ItineraryItem {
  id            String       @id @default(uuid()) @db.Uuid
  itineraryDayId String      @db.Uuid
  startTime     String       @db.VarChar(5)
  title         String
  description   String
  estimatedCost Decimal      @db.Decimal(12, 2)
  currency      String       @db.VarChar(3)
  itineraryDay  ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

  @@index([itineraryDayId, startTime])
}
