{
  "name": "koreamate-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "xhs:server": "uvx --from xiaohongshu-automation xhs-server",
