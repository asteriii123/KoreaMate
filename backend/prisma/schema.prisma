generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationMode {
  TRAVEL
  TRANSLATION
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageContentType {
  TEXT
}

enum JobStatus {
  ACCEPTED
  COMPLETED
  FAILED
}

model Conversation {
  id           String           @id @default(uuid()) @db.Uuid
  mode         ConversationMode
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  messages     Message[]
  jobs         Job[]
  translations Translation[]
  trip         Trip?
  userId       String?          @db.Uuid
  guestId      String?          @db.Uuid
  user         User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest        GuestIdentity?   @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([guestId, updatedAt])
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  sessions      Session[]
  savedPlaces   SavedPlace[]
}

model GuestIdentity {
  id            String         @id @default(uuid()) @db.Uuid
  tokenHash     String         @unique
  createdAt     DateTime       @default(now())
  mergedAt      DateTime?
  conversations Conversation[]
  savedPlaces   SavedPlace[]
}

model EmailVerificationCode {
  id        String    @id @default(uuid()) @db.Uuid
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Message {
  id             String             @id @default(uuid()) @db.Uuid
  conversationId String             @db.Uuid
  role           MessageRole
  contentType    MessageContentType
  content        Json
  idempotencyKey String?
  createdAt      DateTime           @default(now())
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  job            Job?
  translation    Translation?

  @@unique([conversationId, idempotencyKey])
  @@index([conversationId, createdAt])
}

model Translation {
  id                String       @id @default(uuid()) @db.Uuid
  conversationId    String       @db.Uuid
  sourceMessageId   String       @unique @db.Uuid
  sourceLanguage    String
  targetLanguage    String
  sourceText        String
  translatedText    String
  naturalExpression String
  pronunciation     String?
  politeness        String
  provider          String
  createdAt         DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessage     Message      @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Job {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  messageId      String       @unique @db.Uuid
  status         JobStatus    @default(ACCEPTED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  events         JobEvent[]
}

model JobEvent {
  id         String   @id @default(uuid()) @db.Uuid
  jobId      String   @db.Uuid
  sequence   Int
  type       String
  data       Json
  occurredAt DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sequence])
  @@index([jobId, occurredAt])
}

model Trip {
  id                 String           @id @default(uuid()) @db.Uuid
  conversationId     String           @unique @db.Uuid
  title              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  conversation       Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requirement        TripRequirement?
  versions           TripVersion[]
  resources          TripResource[]
  confirmedVersionId String?          @db.Uuid
  confirmedAt        DateTime?

  @@index([confirmedAt])
}

model TripRequirement {
  id           String   @id @default(uuid()) @db.Uuid
  tripId       String   @unique @db.Uuid
  data         Json
  pendingField String?
  updatedAt    DateTime @updatedAt
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripVersion {
  id            String         @id @default(uuid()) @db.Uuid
  tripId        String         @db.Uuid
  versionNumber Int
  title         String
  summary       String
  currency      String         @db.VarChar(3)
  totalCost     Decimal        @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())
  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  days          ItineraryDay[]

  @@unique([tripId, versionNumber])
}

model ItineraryDay {
  id            String          @id @default(uuid()) @db.Uuid
  tripVersionId String          @db.Uuid
  dayNumber     Int
  date          DateTime?       @db.Date
  title         String
  estimatedCost Decimal         @db.Decimal(12, 2)
  tripVersion   TripVersion     @relation(fields: [tripVersionId], references: [id], onDelete: Cascade)
  items         ItineraryItem[]

  @@unique([tripVersionId, dayNumber])
}

model ItineraryItem {
  id             String       @id @default(uuid()) @db.Uuid
  itineraryDayId String       @db.Uuid
  startTime      String       @db.VarChar(5)
  title          String
  description    String
  estimatedCost  Decimal      @db.Decimal(12, 2)
  currency       String       @db.VarChar(3)
  placeId        String?      @db.Uuid
  itineraryDay   ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  place          Place?       @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([itineraryDayId, startTime])
}

model Place {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  nameZh         String?
  normalizedName String
  address        String?
  latitude       Decimal         @db.Decimal(10, 7)
  longitude      Decimal         @db.Decimal(10, 7)
  category       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sources        PlaceSource[]
  itineraryItems ItineraryItem[]
  savedPlaces    SavedPlace[]

  @@index([normalizedName])
}

model SavedPlace {
  id        String         @id @default(uuid()) @db.Uuid
  placeId   String         @db.Uuid
  userId    String?        @db.Uuid
  guestId   String?        @db.Uuid
  note      String?        @db.VarChar(240)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  place     Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest     GuestIdentity? @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@unique([guestId, placeId])
  @@index([userId, createdAt])
  @@index([guestId, createdAt])
}

model PlaceSource {
  id         String   @id @default(uuid()) @db.Uuid
  placeId    String   @db.Uuid
  provider   String
  externalId String
  sourceUrl  String?
  raw        Json
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([placeId, fetchedAt])
}

model TripResource {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @db.Uuid
  kind      String
  provider  String
  query     Json
  data      Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, kind])
}

model ProviderCall {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  operation  String
  status     String
  durationMs Int?
  errorCode  String?
  request    Json
  response   Json?
  createdAt  DateTime @default(now())

  @@index([provider, createdAt])
}
